# Environment variables for FastAPI backend template. 
# Update the values as per your requirements.

API_V1_STR=/api/v1

# Secret key for JWT token generation
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Super user credentials
ADMIN_USER_NAME=
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# pgAdmin settings
PGADMIN_EMAIL=
PGADMIN_PASSWORD=