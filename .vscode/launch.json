{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Local Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "fastapi",
            "args": [
                "dev",
                "app/main.py",
                "--port",
                "8000"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DEBUG": "True"
            },
            "showReturnValue": true
        }
    ]
}
